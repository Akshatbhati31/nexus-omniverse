# NEXUS // OMNIVERSE environment
# Copy to .env.local. Never commit real credentials.

# Optional AI proxy. Leave empty to use the deterministic local assistant.
VITE_NEXUS_AI_ENDPOINT=

# Production integration placeholders. The demo client does not consume these yet;
# they document the intended Supabase migration path in docs/DATABASE.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Demo mode is the current runtime. Production deployment must replace the local
# persistence adapter and enforce authorization through RLS and server-side RPCs.
VITE_NEXUS_DEMO_MODE=true
